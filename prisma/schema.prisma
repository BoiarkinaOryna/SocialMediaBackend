

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // url      = env("DATABASE_URL")
}

model User {
  id         Int     @id @default(autoincrement())
  email      String  @unique
  password   String
  isVerified Boolean @default(false)

  profile Profile?

  createdAt DateTime @default(now())
  albums    Album[]
   posts      Post[]
}

model Profile {
  id        Int     @id @default(autoincrement())
  username  String  @unique
  pseudonym String?
  firstName String?
  lastName  String?
  avatar    String?

  user   User @relation(fields: [userId], references: [id])
  userId Int  @unique

  sentRequests     FriendsRequest[] @relation("from_profile")
  receivedRequests FriendsRequest[] @relation("to_profile")
}

model VerificationCode {
  id        Int      @id @default(autoincrement())
  email     String
  code      String
  isUsed    Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}
  
model Album {
  id    Int    @id @default(autoincrement())
  title String

  topics   String
  year     Int
  isHidden Boolean @default(false)
  // images Image[]

  userId Int
  user   User    @relation(fields: [userId], references: [id])
  // images PostImage[]
}

model PostImage {
  id               Int    @id @default(autoincrement())
  original_image   String
  compressed_image String

  postId Int
  post   Post @relation(fields: [postId], references: [id])
}

model FriendsRequest {
  id Int @id @default(autoincrement())

  fromProfileId Int
  toProfileId   Int

  from_profile Profile @relation("from_profile", fields: [fromProfileId], references: [id])
  to_profile   Profile @relation("to_profile", fields: [toProfileId], references: [id])

  created_at DateTime @default(now())
}
model Post {
  id         Int      @id @default(autoincrement())
  title      String
  topic      String?
  content    String
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  authorId Int
  author   User @relation(fields: [authorId], references: [id])

  // tags   post_app_post_tags[]
  images PostImage[]//
  // likes  PostLike[]
  // hearts PostHeart[]
  // views  PostView[]
  // links  PostLink[]
}